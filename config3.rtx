camera:
{
  resolution = { width = 1200; height = 800; };
  position = { x = 0.0; y = 0.0; z = 0.0; };
  fov = 90.0;
};

primitives:
{
  spheres = (
    { x = 1.0; y = -1.0; z = -5.0; r = 1.2; color = { r = 255; g = 0; b = 0; }; },
    { x = 0.0; y = 0.0; z = -5.0; r = 1.0; color = { r = 0; g = 255; b = 0; }; },
    { x = 2.0; y = 0.0; z = -4.5; r = 1.0; color = { r = 255; g = 255; b = 0; }; }
  );

  planes = (
    { axis = "x"; position = -1.5; color = { r = 255; g = 255; b = 255; }; }
  );

  cylinders = (
    { x = -12.0; y = -4.0; z = -10.0; r = 1.0; h = 2.0; color = { r = 0; g = 0; b = 255; }; },
    { x = 15.0; y = 0.0; z = -15.0; r = 2.0; h = 0.0; color = { r = 0; g = 255; b = 0; }; }
  );

  cones = (
    { x = -3.0; y = 0.0; z = -3.0; r = 20.0; h = 5.0; color = { r = 0; g = 255; b = 255; }; },
    { x = -7.0; y = -5.0; z = -15.0; r = 20.0; h = 0.0; color = { r = 120; g = 120; b = 255; }; }
  );
};

lights:
{
  ambient = 0.1;
  diffuse = 1.0;

  point = (
    { x = -100.0; y = -80.0; z = 10.0; color = { r = 255; g = 255; b = 255; }; intensity = 1.0; },
    { x = 100.0; y = -30.0; z = 5.0; color = { r = 120; g = 120; b = 120; }; intensity = 1.0; }   
  );
};
