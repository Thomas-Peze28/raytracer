camera:
{
  resolution = { width = 1200; height = 800; };
  position = { x = 0.0; y = 0.0; z = 0.0; };
  fov = 90.0;
};

primitives:
{
  spheres = (
    {
      x = 0.0;
      y = 0.0;
      z = -5.0;
      r = 1.0;
      color = { r = 255; g = 80; b = 80; };
      scale = { x = 1.5; y = 1.0; z = 0.75; };
    }
  );

  planes = (
    { axis = "x"; position = -1.5; color = { r = 255; g = 255; b = 255; }; }
  );
};

lights:
{
  ambient = 0.2;
  diffuse = 0.8;

  directional = (
    { x = -1.0; y = -1.0; z = -1.0; }
  );
};
